# VH MEDIA LIVE DOWNLOADER — environment template
#
# Copy to `.env` (or export in your process manager) and fill in real values.
# NEVER commit `.env` or production secrets to Git.
#
# Load example (Linux/macOS with a dotenv-aware launcher), or set the same
# variables in systemd / Windows Service / your orchestrator.

# ---------------------------------------------------------------------------
# Spring
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Graceful shutdown window (must cover FFmpeg stop timeout + a small buffer)
SHUTDOWN_TIMEOUT=45s

# ---------------------------------------------------------------------------
# PostgreSQL (required in prod — no defaults for credentials)
# ---------------------------------------------------------------------------
DB_HOST=db.example.internal
DB_PORT=5432
DB_NAME=live_downloader
DB_USERNAME=live_downloader_app
DB_PASSWORD=change-me-use-a-strong-secret

# HikariCP (optional overrides)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_CONNECTION_TIMEOUT_MS=20000
DB_POOL_MAX_LIFETIME_MS=1200000
DB_POOL_INIT_FAIL_TIMEOUT_MS=1

# ---------------------------------------------------------------------------
# CORS (required in prod — concrete HTTPS origins only, never *)
# Comma-separated. Example: https://app.example.com,https://admin.example.com
# ---------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Media / FFmpeg (install on the host — do not Dockerize blindly yet)
# Prefer absolute paths in production.
# ---------------------------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
RECORDINGS_DIRECTORY=/var/lib/live-downloader/recordings
MAX_CONCURRENT_RECORDINGS=5
PROBE_TIMEOUT_SECONDS=30
STOP_TIMEOUT_SECONDS=20
DELETE_TEMP_AFTER_REMUX=true
PROGRESS_PERSIST_INTERVAL_SECONDS=3
SSE_TIMEOUT_SECONDS=1800

# Same interval throttles editor INFO progress summaries (projectId/exportId/percent).
# FFmpeg frame ticks are not logged.

# Disk capacity guards (bytes). Defaults ≈ 1 GiB in prod.
MIN_FREE_DISK_BYTES=1073741824
DISK_SPACE_THRESHOLD_BYTES=1073741824
VALIDATE_MEDIA_EXECUTABLES=true
# Browser-like headers for CDN/TikTok FLV URLs (ffmpeg/ffprobe -user_agent / -headers)
HTTP_BROWSER_HEADERS_ENABLED=true
# HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/139 Safari/537.36
# HTTP_REFERER=https://www.tiktok.com/

# ---------------------------------------------------------------------------
# Video editor (visual reorder; original audio is locked to output length)
# ---------------------------------------------------------------------------
# Source MP4 upload cap (also Spring multipart + Tomcat max form size). Default 512 MiB.
EDITOR_MAX_UPLOAD_BYTES=536870912
# IMAGE asset cap. Default 20 MiB.
EDITOR_MAX_IMAGE_UPLOAD_BYTES=20971520
EDITOR_STORAGE_DIRECTORY=/var/lib/live-downloader/editor
MAX_CONCURRENT_EDITOR_EXPORTS=2
# Alias kept for compatibility: EDITOR_MAX_CONCURRENT_EXPORTS=2
EDITOR_EXPORT_TIMEOUT_MINUTES=60
EDITOR_DELETE_TEMP_AFTER_EXPORT=true
EDITOR_MAX_SEGMENTS=50
# Minimum VIDEO/IMAGE clip length (default 100 ms). Alias: EDITOR_MIN_SEGMENT_MILLIS.
EDITOR_MIN_SEGMENT_DURATION_MS=100
EDITOR_MIN_SEGMENT_MILLIS=100
# Timestamp slack for source-contiguous cuts / coverage (default 50 ms).
EDITOR_COVERAGE_EPSILON_MILLIS=50
EDITOR_IMAGE_SEGMENTS_ENABLED=false
EDITOR_QUALITY_FAST_PRESET=veryfast
EDITOR_QUALITY_FAST_CRF=26
EDITOR_QUALITY_BALANCED_PRESET=medium
EDITOR_QUALITY_BALANCED_CRF=23
EDITOR_QUALITY_HIGH_PRESET=slow
EDITOR_QUALITY_HIGH_CRF=20
# Audio Locked: original[0 .. outputDurationMillis]. Reorder/speed do not move or pitch audio.
# Trim / output-range shortens audio to the new output. No new env vars for that policy.
# Swagger UI is enabled outside prod; application-prod.yml disables springdoc.
# Phase 2 — ignored until preview rendering is implemented
EDITOR_PREVIEW_ENABLED=false
EDITOR_PREVIEW_MAX_WIDTH=1280

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
BLOCK_PRIVATE_STREAM_ADDRESSES=true
SECURITY_HEADERS_ENABLED=true

# ---------------------------------------------------------------------------
# API / Tomcat (optional)
# ---------------------------------------------------------------------------
API_MAX_PAGE_SIZE=100
SERVER_TOMCAT_MAX_THREADS=50
SERVER_TOMCAT_MIN_SPARE=5
